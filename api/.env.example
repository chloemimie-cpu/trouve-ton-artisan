# Port de l'API
PORT=3000

# Base de donnees
# Port MySQL/MariaDB : 3306 en general (3307 avec MariaDB sous WAMP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trouve_ton_artisan
DB_USER=artisan_api
DB_PASSWORD=

# Adresse du front (autorisee par le CORS)
CLIENT_URL=http://localhost:5173

# Expediteur des e-mails du formulaire de contact
MAIL_FROM=no-reply@trouve-ton-artisan.example
